{
  "name": "envitefy",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "node scripts/dev-single.js",
    "dev:turbo": "node scripts/dev-single.js --turbopack",
    "build": "node scripts/next-build.js",
    "build:turbo": "node scripts/next-build.js --turbo",
    "start": "next start",
    "start:standalone": "node .next/standalone/server.js",
    "clean": "node -e \"const fs=require('fs');for(const d of ['.next','.next-dev']){try{fs.rmSync(d,{recursive:true,force:true});console.log('removed '+d)}catch(e){console.error(e);process.exit(1)}}\"",
    "lint": "biome lint .",
    "lint:vscode": "node scripts/vscode-lint.mjs",
    "test:customer-entrypoints": "node scripts/run-customer-entrypoint-tests.mjs",
    "test:dependencies": "node scripts/run-dependency-tests.mjs",
    "test:mobile": "node scripts/run-mobile-tests.mjs",
    "test:mobile:update": "node scripts/run-mobile-tests.mjs --update",
    "test:mobile:full": "node scripts/run-mobile-tests.mjs --full",
    "test:mobile:lighthouse": "npm run build && node scripts/run-lighthouse.mjs",
    "test:lighthouse:runner": "node --test scripts/run-lighthouse.test.mjs",
    "verify:share-preview": "node scripts/verify-share-preview.mjs",
    "lint:fix": "biome lint --write .",
    "format": "biome format --write .",
    "check": "biome check .",
    "icons": "node scripts/generate-icons.js",
    "favicon": "node scripts/generate-favicon.js",
    "db:init": "node scripts/init-db.js",
    "blob:backfill-pathnames": "node scripts/backfill-discovery-blob-pathnames.mjs",
    "blob:input-blobs-report": "node scripts/report-event-history-input-blobs-shape.mjs",
    "blob:delete-broken-input-blobs": "node scripts/delete-broken-event-history-input-blobs.mjs",
    "blob:transport-event-media": "node --experimental-strip-types scripts/transport-event-media-to-blob.ts",
    "purge:user-event-data": "node --experimental-strip-types scripts/purge-user-event-data.ts",
    "purge:expired-private-data": "node scripts/purge-expired-private-data.mjs",
    "signup:templates": "node scripts/generate-signup-templates-openai.mjs",
    "signup:templates:nana": "node scripts/generate-signup-templates-google.mjs --profile=nana",
    "signup:templates:openrouter": "node scripts/generate-signup-templates-openrouter.mjs",
    "signup:templates:openrouter:nana": "node scripts/generate-signup-templates-openrouter.mjs --profile=nana",
    "images:optimize": "node scripts/optimize-public-images.mjs",
    "images:optimize:diff": "node scripts/optimize-public-images.mjs --diff",
    "images:optimize:diff:webp": "node scripts/optimize-public-images.mjs --diff --emit-webp",
    "images:optimize:staged": "node scripts/optimize-public-images.mjs --staged",
    "images:optimize:staged:webp": "node scripts/optimize-public-images.mjs --staged --emit-webp",
    "images:optimize:signup-webp": "node scripts/optimize-public-images.mjs --signup-templates-webp",
    "images:optimize:signup-webp:diff": "node scripts/optimize-public-images.mjs --signup-templates-webp --diff",
    "images:optimize:signup-webp:staged": "node scripts/optimize-public-images.mjs --signup-templates-webp --staged",
    "birthday:themes": "node scripts/generate-birthday-theme-images.mjs",
    "birthday:extract-elements": "node scripts/extract-theme-elements.mjs",
    "storyboard:generate": "node scripts/generate-storyboard-images.mjs",
    "storyboard:video": "node scripts/assemble-storyboard-video.mjs",
    "marketing:campaign": "node scripts/generate-marketing-campaign.mjs",
    "campaign": "node scripts/generate-marketing-campaign.mjs",
    "campaign:video": "node scripts/assemble-storyboard-video.mjs",
    "concierge:persona-eval": "bun scripts/concierge-persona-eval.mjs",
    "concierge:persona-eval:challenge": "bun scripts/concierge-persona-eval.mjs --challenge --max-turns=14",
    "creation:backfill-source-intent": "node scripts/backfill-creation-source-intent.mjs",
    "events:backfill-public-slugs": "node scripts/backfill-event-public-slugs.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-sesv2": "^3.887.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@google-cloud/aiplatform": "^5.11.0",
    "@google-cloud/storage": "^7.12.1",
    "@google-cloud/vertexai": "^1.10.0",
    "@google-cloud/vision": "^5.3.3",
    "@google/genai": "^1.48.0",
    "@hugeicons/core-free-icons": "^4.2.0",
    "@hugeicons/react": "^1.1.6",
    "@napi-rs/canvas": "^1.0.8",
    "@prisma/client": "^6.15.0",
    "@radix-ui/react-accordion": "^1.2.12",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@supabase/supabase-js": "^2.95.3",
    "@types/bcryptjs": "^2.4.6",
    "@types/canvas-confetti": "^1.9.0",
    "@vercel/blob": "^2.3.2",
    "@vercel/speed-insights": "^1.3.1",
    "balloons-js": "^0.0.3",
    "bcryptjs": "^3.0.2",
    "canvas-confetti": "^1.9.4",
    "chrono-node": "^2.8.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cookie": "^1.0.2",
    "dotenv": "^16.4.5",
    "ffmpeg-static": "^5.3.0",
    "framer-motion": "^12.38.0",
    "googleapis": "^156.0.0",
    "ical-generator": "^9.0.0",
    "jose": "^6.0.13",
    "lucide-react": "^0.473.0",
    "motion": "^12.40.0",
    "multer": "^2.0.2",
    "next": "15.5.25",
    "next-auth": "^4.24.7",
    "next-connect": "^1.0.0",
    "nodemailer": "^10.0.1",
    "openai": "^4.76.3",
    "pdfjs-dist": "^6.3.289",
    "pg": "^8.16.3",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-tooltip": "^5.30.1",
    "sharp": "^0.35.4",
    "tw-animate-css": "^1.4.0"
  },
  "overrides": {
    "next-auth": {
      "nodemailer": "$nodemailer"
    },
    "next": {
      "postcss": "8.5.28"
    },
    "@prisma/config": {
      "deepmerge-ts": "8.0.2"
    },
    "uuid@<11.1.1": "11.1.1",
    "qs@<6.16.0": "6.16.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@biomejs/biome": "^2.4.8",
    "@tailwindcss/postcss": "^4",
    "@types/cookie": "^0.6.0",
    "@types/multer": "^2.0.0",
    "@types/node": "^24",
    "@types/pg": "^8.15.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "chrome-launcher": "1.2.1",
    "lighthouse": "13.4.1",
    "playwright": "^1.59.0",
    "png-to-ico": "^3.0.1",
    "prisma": "^6.15.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
