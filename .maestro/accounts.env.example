# Copy to .env.maestro.local at the repository root. Keep real values out of Git.
# Leave empty until the test environment and twelve distinct accounts are provided.
MAESTRO_BASE_URL=
MAESTRO_PLATFORM=android
MAESTRO_AUTH_PROVIDER=google
MAESTRO_ANDROID_APP_ID=com.envitefy.app
# Optional when exactly one Android device is connected.
MAESTRO_ANDROID_SERIAL=

MAESTRO_QA01_EMAIL=
MAESTRO_QA01_PASSWORD=
MAESTRO_QA02_EMAIL=
MAESTRO_QA02_PASSWORD=
MAESTRO_QA03_EMAIL=
MAESTRO_QA03_PASSWORD=
MAESTRO_QA04_EMAIL=
MAESTRO_QA04_PASSWORD=
MAESTRO_QA05_EMAIL=
MAESTRO_QA05_PASSWORD=
MAESTRO_QA06_EMAIL=
MAESTRO_QA06_PASSWORD=
MAESTRO_QA07_EMAIL=
MAESTRO_QA07_PASSWORD=
MAESTRO_QA08_EMAIL=
MAESTRO_QA08_PASSWORD=
MAESTRO_QA09_EMAIL=
MAESTRO_QA09_PASSWORD=
MAESTRO_QA10_EMAIL=
MAESTRO_QA10_PASSWORD=
MAESTRO_QA11_EMAIL=
MAESTRO_QA11_PASSWORD=
MAESTRO_QA12_EMAIL=
MAESTRO_QA12_PASSWORD=

# Existing dedicated test records. See docs/maestro-qa.md for prerequisites.
# QA02: owned Live Card draft with ready artwork; the test publishes it.
MAESTRO_QA02_EVENT_ID=
# QA03: owned, published Live Card with ready artwork.
MAESTRO_QA03_EVENT_ID=
# QA05: owned private medical scan, with its existing original document.
# EVENT_TITLE is the title displayed on the page; names are expected test values.
MAESTRO_QA05_EVENT_ID=
MAESTRO_QA05_EVENT_TITLE=
MAESTRO_QA05_PATIENT_NAME=
MAESTRO_QA05_CLINICIAN_NAME=
# QA06 owns this published signup form and the separate QA07/QA08/QA10 forms.
MAESTRO_QA06_EVENT_ID=
MAESTRO_QA06_SLOT_LABEL=
# QA07: a separate published form, with an open slot and no QA07 reservation.
MAESTRO_QA07_EVENT_ID=
MAESTRO_QA07_SLOT_LABEL=
# QA08: a separate published form, with a full slot and waitlisting enabled.
# OCCUPIED_RESPONSE_ID is a dedicated reservation the API check will cancel.
MAESTRO_QA08_EVENT_ID=
MAESTRO_QA08_SLOT_LABEL=
MAESTRO_QA08_OCCUPIED_RESPONSE_ID=
# QA09: a published Live Card owned by QA02, with a pending invitation to QA09.
MAESTRO_QA09_EVENT_ID=
MAESTRO_QA09_EVENT_TITLE=
# QA10: a published signup form owned by QA06, with a pending invitation to QA10.
MAESTRO_QA10_EVENT_ID=
MAESTRO_QA10_EVENT_TITLE=
# QA11: owned, published Live Card with calendar actions enabled.
MAESTRO_QA11_EVENT_ID=
MAESTRO_QA11_EVENT_TITLE=
# QA12: unrelated to all tested owners. This ID must equal QA05_EVENT_ID.
MAESTRO_QA12_EVENT_ID=
