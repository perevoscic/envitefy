{
  "ci": {
    "collect": {
      "startServerCommand": "npm run start -- -p 3100",
      "startServerReadyPattern": "Ready in|ready - started server|Local:",
      "url": [
        "http://localhost:3100/landing",
        "http://localhost:3100/gymnastics",
        "http://localhost:3100/snap"
      ],
      "numberOfRuns": 3,
      "settings": {
        "onlyCategories": ["performance", "accessibility"],
        "throttlingMethod": "devtools",
        "chromeFlags": "--no-sandbox"
      }
    },
    "assert": {
      "assertions": {
        "categories:accessibility": ["error", { "minScore": 0.9 }],
        "categories:performance": ["warn", { "minScore": 0.8 }],
        "largest-contentful-paint": ["error", { "maxNumericValue": 2500 }],
        "cumulative-layout-shift": ["error", { "maxNumericValue": 0.1 }]
      }
    },
    "upload": {
      "target": "filesystem",
      "outputDir": "qa-artifacts/lighthouse"
    }
  }
}
